{
  "name": "atomcode-acp",
  "version": "1.0.0",
  "description": "ACP (Agent Client Protocol) adapter bridge for AtomCode CLI and Antigravity (agy)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "atomcode-acp": "./bin/atomcode-acp.js",
    "agy-acp": "./bin/agy-acp.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "tsx --test test/*.test.ts",
    "test:live:atomcode": "tsx test/test-client.ts",
    "test:live:agy": "tsx test/test-agy.ts",
    "test:parser": "tsx test/test-parser.ts"
  },
  "keywords": [
    "acp",
    "agent-client-protocol",
    "atomcode",
    "antigravity",
    "agy",
    "codeg",
    "ai-agent"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
